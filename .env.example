# Copy this file to .env and fill in the values. .env is never committed.
POSTGRES_DB=vigie
POSTGRES_USER=vigie
POSTGRES_PASSWORD=change-me

# Key used to sign session tokens. Generate your own with:
#   openssl rand -base64 48
VIGIE_JWT_SECRET=

# Optional: creates an administrator account at startup (password: 12+ characters).
VIGIE_ADMIN_EMAIL=
VIGIE_ADMIN_PASSWORD=
